#lang racket

 (require data/heap)

(define a-heap-of-strings (make-heap string<=?) )

(heap-add! a-heap-of-strings "z" "b")
(heap->vector a-heap-of-strings)


; priority queue -> just like queue
; example: severity ranking in ER
; constraints:
; 1. when we insert data, maintain proper order
; 2. data can be removed from the end
; weakness is the O(n) adding stuff


; HEAPS
; binary heap (binary tree)
; max heap, min heap

; COND1:
; - value of each node must be greater than each of its descendant
; - also known as 'heap condition'.
; - absolute max value sits at the top
; - compared to bst (horizontal data order), heaps order data vertically

; COND2: tree must be complete.
; - the tree must be completely filled with nodes
; - fill higher row first (cant put in row 3 till 1&2 are full)
; - only the bottom row can have empty positions
; - left to right only

; SEARCH LAST NODE
; why is heap dependant on last node?
; why is heap dependant on complete tree?
; because it ensures the heap remains well balanced.
; it ensures O(log n) running time

; RUNNING TIME
; HEAP INSERTION: O(log n)
; HEAP DELETION: O(log n)

; ===============================================

; a Heap is a Vector
; holds vector of Number where each contains
; index arithmetic thing (i * 2) + 1. first item = root
; last item = last node
; parent: (i * 2) + 1
; child (i-1) / 2

; SAMPLE
(define sample-heap (vector 100 88 25 87 16 8 12 86 50 2 15 3))
; root = 100, last node = 3

; SELECTORS
; lets just assume heap is nonempty

; Vector -> Number
(define (heap-root heap)
  (vector-ref heap 0)
  )
(heap-root sample-heap) ; 100

; Vector -> Number
(define (heap-last heap)
  (vector-ref heap (- (vector-length heap) 1))
  )
(heap-last sample-heap) ;3

; Vector Number -> Number
(define (heap-lc-idx heap i)
  (+ (* i 2) 1)
  )

; Vector Number -> Number
(define (heap-rc-idx heap i)
  (+ (* i 2) 2)
  )

; Vector Number -> Number
(define (heap-parent-idx heap i)
  (quotient (- i 1) 2)
  )

; ==================================================

; OP: HEAP INSERTION -> O(n)
; 1. insert at rightmost spot in the bottom level
; (this will be the new last node)
; 2. compare it with its parent node
; 3. if greater -> swap. else keep
; 4. repeat until it 'bubbles' up and in correct position
; (also called 'trickling' the node up)

; Vector Number Number -> Void
(define (vector-swap! vect i j)
  (let ((temp-i-val (vector-ref vect i)))
    ; temp-i-val = i -> i = j -> j = temp-i-val
    (begin (vector-set! vect i (vector-ref vect j))
           (vector-set! vect j temp-i-val)
           'vector-swapped!
           )
    )
  )
(vector-swap! (vector 0 1 2 3) 0 1);swaps pos 0 and 1

(define (insert heap value)
  (let* ((new-heap (vector-append heap (vector value)))
         (new-node-idx (- (vector-length new-heap) 1)))

   
    (define (insert-helper h i)
      (cond [(zero? i) h] ; at the top, done and return new-heap
            [else (let* ((parent-node-idx (heap-parent-idx h i))
                         (parent-node-val (vector-ref h parent-node-idx))
                         (curr-node-val (vector-ref h i)))

                    (if (> curr-node-val parent-node-val)
                        ; swap it
                        (begin (vector-swap! h i parent-node-idx)
                               (insert-helper h parent-node-idx))
                        ; keep it
                        h
                        )
                    )]
            )
      )
    (insert-helper new-heap new-node-idx)
    )
  )
;(insert sample-heap 1)

; ==================================================


; OP: HEAP DELETION

; only ever delete the root node!
; 1. move last node to root node (remove original root node)
; 2. trickle root node down:
; 2a. checkb oth children see which one is larger
; 2b. if trickle node < larger of the 2 nodes, swap it with the larger
; 2c. repeat until tricle node has no children who are greater than it.

(define (pop heap)
  (let* ((val-to-delete (vector-ref heap 0))
        (last-node-idx (- (vector-length heap) 1))
        (overwrite-root! (vector-set! heap 0 (vector-ref heap last-node-idx)))
        (new-heap (vector-copy heap 0 last-node-idx)))
    ; trickle down
    ; check for children
    ; find champion (no children, left children, both children)
    ; copmare and swap
    (define (pop-helper h i)
      (cond [(>= (heap-lc-idx h i) (vector-length h)) h] ; out of bound
            [(>= (heap-rc-idx h i) (vector-length h))
             (let* ((curr-val (vector-ref h i))
                    (lc-idx (heap-lc-idx h i))
                    (lc-val (vector-ref h lc-idx)))
               
               (if (> curr-val lc-val)
                   h ; keep it
                   (begin (vector-swap! h i lc-idx) h) ; swap it
                   ))] ; only leftchild
            [else (let* ((curr-val (vector-ref h i))
                         (lc-idx (heap-lc-idx h i))
                         (rc-idx (heap-rc-idx h i))
                         (lc-val (vector-ref h lc-idx))
                         (rc-val (vector-ref h rc-idx))
                         (bigger-val (max lc-val rc-val))
                         (bigger-val-idx (if (> lc-val rc-val) lc-idx rc-idx))
                         )
                    
                    (if (> curr-val bigger-val)
                        ; stop, its in correct pos
                        h
                        ; trickle
                        (begin (vector-swap! h bigger-val-idx i)
                               (pop-helper h bigger-val-idx))
                        )
                    )] 
            )
      )
    (pop-helper new-heap 0)
    
    )
  )
(pop sample-heap)

; ==================================================


; ARRAY HEAP
; node -> left -> right (preorder traversal)
; first item = root, last item = last node

; ==================================================
