#|
EXERCISE 3
write three different implementations of a function that finds the
greatest number within an array. write one function that is O(n^2),
O(n log n), and one that is O(N).

answer:
lets just do all of these in list / functional style
|#

; v1: O(n^2) - assume list is nonempty
(define (greatest-number-v1 xs)

  ; number listof number -> boolean
  ; this or wecan do andmap
  (define (greatest-in-list? x lst)
    (cond [(null? lst) #t]
          [(> (car lst) x) #f]
          [else (greatest-in-list? x (cdr lst))]
          )
    )

  ; main function that runs the inner loop
  (define (helper lst)
    (cond [(null? (cdr lst)) (car lst)]
          [(greatest-in-list? (car lst) xs) (car lst)]
          [else (helper (cdr lst))]
          )
    )
  (helper xs)
  
  )
(display 'greatest-number-v1)(newline)
(greatest-number-v1 '(2 5 4 1 0)) ; should return 5
(greatest-number-v1 '(3 2 5 6 9 7 1 0 4)) ; should return 9

; v2: O(n log n)
(define (greatest-number-v2 xs)
  ; sort the list, then compare - similar to 3rd version??
  (let* ((sorted-xs (sort xs <)))

    ; largest is at the end
    (last sorted-xs)
    
    )
  
  )
(display 'greatest-number-v2)(newline)
(greatest-number-v2 '(2 5 4 1 0)) ; should return 5
(greatest-number-v2 '(3 2 5 6 9 7 1 0 4)) ; should return 9


; v3: O(N)
; tail recursive style
; assume list is nonempty
(define (greatest-number-v3 xs)

  ; listof number number -> number
  (define (greatest-helper lst greatest-so-far)
    (cond [(null? lst) greatest-so-far]
          [(> (car lst) greatest-so-far) (greatest-helper (cdr lst) (car lst) )] ;update
          [else (greatest-helper (cdr lst) greatest-so-far)])
    )
  (greatest-helper (cdr xs) (car xs))
  
  )
(display 'greatest-number-v3)(newline)
(greatest-number-v3 '(7))
(greatest-number-v3 '(16 2))
(greatest-number-v3 '(2 5 4 1 0)) ; should return 5
(greatest-number-v3 '(3 2 5 6 9 7 1 0 4)) ; should return 9
