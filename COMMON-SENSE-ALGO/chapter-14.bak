; EXERCISE

#|
1.  Given an array of positive numbers, write a function that returns the
greatest product of any three numbers. The approach of using three
nested loops would clock in at O(N3), which is very slow. Use sorting to
implement the function in a way that it computes at O(N log N) speed.
(Some other implementations are even faster, but we’re focusing on using
sorting as a technique to make code faster.)

answer:
|#

; listof number -> number
; list/functional style
(define (greatest-product-of-any-three xs)
  (let* ((sorted-xs (sort xs <))
        (reverse-sorted-xs (reverse sorted-xs))
        )

    (* (car reverse-sorted-xs)
       (cadr reverse-sorted-xs)
       (caddr  reverse-sorted-xs) )
   
      )
    )
(display 'greatest-product) (newline)
(greatest-product-of-any-three '(9 8 1)) ;72
(greatest-product-of-any-three '(3 6 2 1 5 4)) ;shuold return '(6 . 5 . 4) = 120

; imperative/vector style
(define (greatest-product-of-any-three-v2 vect)
  (let ((n (- (vector-length vect) 1))
        (sorted-vect (vector-sort vect <)))

    (define (helper v i greatest-so-far)
      (cond [(> i n) greatest-so-far]
            [(> (+ i 2) n) greatest-so-far]
            [else (let* ((fst (vector-ref v i))
                         (sec (vector-ref v (+ i 1)))
                         (thd (vector-ref v (+ i 2)))
                         (curr-product (* fst sec thd)))
                    (if (> curr-product greatest-so-far)
                        (helper v (+ i 1) curr-product)
                        (helper v (+ i 1) greatest-so-far)
                        )
                    )])
      )
    (helper sorted-vect 0 0)
    )
  )

(greatest-product-of-any-three-v2 (vector 3 6 2 1 5 4))

