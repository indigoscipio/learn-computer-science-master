; BST -> Number
(define (bst-max bst)
  (cond [(bst-empty? bst) (error "BST is empty")] ;guard but lets assume bst is nonempy
        [(bst-empty? (bst-right bst)) (bst-root bst)]
        [else (bst-max (bst-right bst)) ]
        )
  )
(bst-max bst2)

