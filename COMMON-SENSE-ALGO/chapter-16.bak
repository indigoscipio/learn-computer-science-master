; BST -> (listof Number)
(define (bst-postorder bst)
  (cond [(bst-empty? bst) '()]
        [else (append (bst-postorder (bst-left bst))
                      (bst-postorder (bst-right bst))
                      (list (bst-root bst))
                      )
              ]
        )
  )
(bst-postorder bst2)

