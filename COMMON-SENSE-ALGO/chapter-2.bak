#lang racket

(let loop ((x 10))
  (cond [(zero? x) 0]
        [else (cons x (loop (- x 1)))]
        )
  )

(for [(i (list 1 2 3))]
  (println i)
  )

; Time is not a good yardstick
; 2 seconds to run -> might run slow on older machine
; steps stay the same
; list vs vector -> vector is isntant, list is linear

