#|
EXERCISE 3
Write a function that accepts a string that contains all the letters of the
alphabet except one and returns the missing letter. For example, the string,
"the quick brown box jumps over a lazy dog" contains all the letters of the alphabet
except the letter "f". The function should have a time complexity of O(N).

answer:
|#

; char -> boolean
(define (char-whitespace? char)
  (equal? char #\space)
  )

(define (symbol->char sym)
  (string-ref (symbol->string sym) 0)
  )
(symbol->char 'a)

; functional/list regular style
; assume input is all lowcase
; probably not ON
; string -> symbol
(define (contains-alphabet-except-one str)
  ; parse and clean the input, ignore whitespace
  ; create a alphabet list/lookup (a .. z) with index 0 - 26, initialize to false
  ; at the end there should be 1 with false i think

  (let* ((chars (string->list str))
         (clean-chars (filter (λ (c) (not (char-whitespace? c))) chars))
         (los (map (λ (c) (string->symbol (string c)) ) clean-chars))
         (alphabet (make-vector 26 #f))
         )

    ; index 0 = a, index 1 = b
    (define (loop curr-xs)
      (cond [(null? curr-xs) 'done]
            [else (let* ((curr-item (car curr-xs))
                         (i (- (char->integer (symbol->char curr-item))
                               (char->integer #\a)))
                         )

                    (vector-set! alphabet i #t)
                    (loop (cdr curr-xs))
                    
                    )]
            )
      )
    (loop los)

    ; vector number number character -> character
    ; maybe im overcomplicating it but this should do
    (define (find-missing vect i n result)
      (cond [(> i n) result]
            [else (let ((curr-item (vector-ref alphabet i)))
                    (if curr-item
                        (find-missing vect (+ i 1) n result)
                        (find-missing vect (+ i 1) n (integer->char
                                                      (+ i (char->integer #\a)))))

                    )]
            )
      )
    (find-missing alphabet 0 (- (vector-length alphabet) 1) '())
    
    )
  
  )
(contains-alphabet-except-one "the quick brown box jumps over a lazy dog") ;f
(contains-alphabet-except-one "abcdefghijklmnopqrstuvwxyy") ;z

; with hash table
; string -> symbol
; assume all input is lowcase


(define (contains-alphabet-except-one-v2 str)
  (let* ((chars (string->list str))
        (clean-chars (filter (λ (c) (not (char-whitespace? c))) chars))
        (los (map (λ (c) (string->symbol (string c)) ) clean-chars))
        (ht (make-hash))
        (alphabet-xs '(a b c d e f g h i j k l m n o p q r s t u v w x y z)))

    
    (define (fill-ht lst)
      (cond [(null? lst) 'done]
            [else (begin (hash-set! ht (car lst) 0)
                         (fill-ht (cdr lst))
                         ) ]
            )
      )
    (fill-ht alphabet-xs)

    ;iterate though the pased input and cross check
    ; increase count for each
    ; at the end check which one has > 1
    ; list-of-x -> void
    (define (loop xs)
      (cond [(null? xs) 'done]
            [else (let ((k (car xs)))
                    (begin (hash-update! ht k add1)
                           (loop (cdr xs)))
                    )]
            )
      )
    (loop los)

    (car (findf (λ (p) (zero? (cdr p)) ) (hash->list ht)))

    )
  )
(contains-alphabet-except-one-v2 "the quick brown box jumps over a lazy dog") ;f
(contains-alphabet-except-one-v2 "abcdefghijklmnopqrstuvwxyy") ;z

