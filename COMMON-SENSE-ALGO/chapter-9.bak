#|
 EXERCISE 2
 Write a function that accepts an array of strings and returns the first
duplicate value it finds. For example, if the array is ["a", "b", "c", "d", "c", "e",
"f"], the function should return "c", since it’s duplicated within the array.
(You can assume that there’s one pair of duplicates within the array.)
Make sure the function has an efficiency of O(N)

answer:
|#

; regular approach
; not sure if this is On, with member again
; list-of-number -> number
(define (find-duplicate xs)

  ; since theres only 1 pair
  (define (loop curr-xs)
    (cond [(null? curr-xs) #f]
          [(member (car curr-xs) (cdr curr-xs) ) (car curr-xs)]
          [else (loop (cdr curr-xs))]
          )
    )
  (loop xs)
   
  )
(find-duplicate '(a b c d c e f)) ; should return 'c'


; with hash table
; list-of-number -> number
(define (find-duplicate-v2 xs)
  ; map each item in xs to a hash tbale and initalize value to 0
  ; walk trhough xs and increase count
  ; at the end just grab whaever has the max value
  (let ((ht (make-hash)))
    
    (define (fill-ht lst)
      (cond [(null? lst) 'done]
            [else (begin (hash-set! ht (car lst) 0)
                         (fill-ht (cdr lst))
                         ) ]
            )
      )
    

    (define (loop lst)
      (cond [(null? lst) 'done]
            [else (let* ((curr-item (car lst)))
                    (begin (hash-update! ht curr-item add1)
                           (loop (cdr lst)))
                    )]
            )
      )

    ; initialize and begin the hash fill
    (begin (fill-ht xs) (loop xs))

    ; return the max
    (car (foldr  (λ (x acc) (let ((sym (car x))
                                  (count (cdr x)))
                              (if (> count (cdr acc))
                                  (cons sym count) ;update
                                  acc ; keep
                                  )
                              ) ) '(0 . 0) (hash->list ht)))
    
    )
  )
(find-duplicate-v2 '(a b c d c e f))

