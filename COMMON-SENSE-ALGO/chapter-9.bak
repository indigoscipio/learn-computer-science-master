#|
EXERCISE 4
Write a function that returns the first non-duplicated character in a string.
For example, the string, "minimum" has two characters that only exist
once—the "n" and the "u", so your function should return the "n", since it
occurs first. The function should have an efficiency of O(N).

answer:|#


; lets just go with the hashtable
; assume str is all lowercase and has no whitespace and keep it simple
(define (first-nondup-char str)
  (let* ((chars (string->list str))
         (clean-chars (filter (λ (c) (not (char-whitespace? c))) chars))
         (los (map (λ (c) (string->symbol (string c)) ) clean-chars))
         (ht (make-hash)))

    ; fill ht
    (define (fill-ht lst)
      (cond [(null? lst) 'done]
            [else (begin (hash-set! ht (car lst) 0)
                         (fill-ht (cdr lst))
                         ) ]
            )
      )
    (fill-ht los)

    ; count each occurence, and only return the first with count = 1
    (define (loop lst)
      (cond [(null? lst) 'done]
            [else (let ((k (car lst)))
                    (begin (hash-update! ht k add1)
                           (loop (cdr lst))
                           )
                    
                    )]
            )
      )
    (loop los)

    (findf (λ (c) (= (hash-ref ht c) 1) ) los)
    
    )
  )
(first-nondup-char "minimum") ;n
(first-nondup-char "maximum") ;a

