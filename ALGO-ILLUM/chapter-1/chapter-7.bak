(define (weighted-median items weights)
  (let* ((total-w (foldr + 0 weights))
         (total-w/2 (/ total-w 2))
         (pairs (map (λ (x y) (cons x y)) items weights))
         )
    
    (define (helper xs)
      (cond [(null? xs) '()]
            [else (let ((pair (car xs))
                        (v (car pair))
                        (w (cdr pair))
                        (pivot pair)
                        (partitioned-xs 0)
                        )
                    0
                    )]
            )
      )
    (helper pairs)
    
    )
  )
(weighted-median '(10 20 30 40 50) '(1 2 3 4 5))

